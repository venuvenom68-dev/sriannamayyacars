# Copy this file to .env and fill in your values. NEVER commit the real .env.
#
# Local development uses the values shown here.
# For PRODUCTION on GoDaddy, set these as environment variables in the
# Node.js App panel (do not upload a .env with real secrets).

# Database — local Mongo for dev; MongoDB Atlas connection string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/annamayyacars

# API server port
PORT=5000

# Public base URL of THIS backend (used to build image links).
# Production example: https://api.sriannamayyacars.in
PUBLIC_URL=http://localhost:5000

# The customer website URL (used for CORS + links).
# Production example: https://sriannamayyacars.in
FRONTEND_URL=http://localhost:3000

# Extra allowed website origins for CORS, comma-separated (e.g. the admin site).
# Production example: https://sriannamayyacars.in,https://admin.sriannamayyacars.in
ALLOWED_ORIGINS=

# Admin login password (owner types this at /admin). Use a strong value.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret that signs admin login tokens. Use 64+ random characters.
JWT_SECRET=change-me-to-a-long-random-secret
